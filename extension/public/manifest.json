{
  "manifest_version": 3,
  "name": "LiveTranslate",
  "version": "0.1.0",
  "description": "LiveTranslate: autentikasi dan asisten rapat.",
  "action": {
    "default_popup": "index.html"
  },
  "host_permissions": [
    "http://localhost:8989/*",
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "https://meet.jit.si/*"
  ],
  "permissions": [
    "storage",
    "alarms",
    "tabCapture",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
