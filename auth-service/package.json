{
  "name": "livetranslate-auth-service",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --test --test-isolation=none test/*.test.ts",
    "test:database": "node --test --test-isolation=none test/database.integration.ts",
    "db:generate": "drizzle-kit generate --custom",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.58.0",
    "drizzle-orm": "0.44.6",
    "postgres": "3.4.7"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "drizzle-kit": "0.31.5",
    "typescript": "5.9.3"
  }
}
